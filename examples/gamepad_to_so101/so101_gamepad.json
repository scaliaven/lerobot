{
  "env": {
    "name": "real_robot",
    "fps": 15,
    "robot": {
      "type": "so101_follower",
      "port": "/dev/tty.usbmodemXXXXXXXXXXX",
      "id": "my_awesome_follower_arm",
      "use_degrees": true,
      "max_relative_target": 6.0,
      "disable_torque_on_disconnect": true,
      "num_torque_retries": 2,
      "cameras": {}
    },
    "teleop": {
      "type": "gamepad",
      "use_gripper": true,
      "use_sdl_controller": true,
      "hidapi_fallback": false
    },
    "processor": {
      "control_mode": "gamepad",
      "observation": {
        "display_cameras": false
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": 0.0
      },
      "max_gripper_pos": 100.0,
      "reset": {
        "fixed_reset_joint_positions": null,
        "control_time_s": 600.0,
        "terminate_on_success": false
      },
      "inverse_kinematics": {
        "urdf_path": "outputs/gamepad/SO101/so101_new_calib.urdf",
        "target_frame_name": "gripper_frame_link",
        "end_effector_bounds": {
          "min": [-0.4, -0.4, -0.1],
          "max": [0.4, 0.4, 0.5]
        },
        "end_effector_step_sizes": {
          "x": 0.002,
          "y": 0.002,
          "z": 0.002
        }
      }
    }
  },
  "dataset": {
    "repo_id": "local/gamepad_so101",
    "task": "manual gamepad control",
    "num_episodes_to_record": 1000000,
    "push_to_hub": false
  },
  "mode": null,
  "device": "cpu"
}
