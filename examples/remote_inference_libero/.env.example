# Trusted Bash configuration. Copy to .env on both machines.
# SSH alias or user@hostname; keys/ports/jump hosts go in ~/.ssh/config.
REMOTE_SSH=''
SERVER_PORT=8080
LOCAL_PORT=18080

# This checkpoint was trained for this LIBERO suite; no training is needed to try it.
# This is evaluation of a LIBERO-finetuned model, not a zero-shot SO-101 controller.
OPENVLA_MODEL='openvla/openvla-7b-finetuned-libero-spatial'
LIBERO_SUITE=libero_spatial
QUANTIZATION=4bit
TASK_ID=0
EPISODES=1
MAX_STEPS=220
REQUEST_TIMEOUT=120
PREVIEW_PORT=8090

# New directory per run, relative to this example folder (or set an absolute path).
OUTPUT_DIR="outputs/$(date +%Y%m%d-%H%M%S)"
DOCKER_IMAGE=lerobot-libero-client
