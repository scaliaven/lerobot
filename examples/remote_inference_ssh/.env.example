# Trusted Bash configuration. Copy to .env on each computer; never put tokens here.
# The server needs POLICY_TYPE, SERVER_PORT and FPS; the client needs all fields.

# SSH config alias, or user@hostname. Configure custom SSH ports/keys in ~/.ssh/config.
REMOTE_SSH=''
SERVER_PORT=8080
LOCAL_PORT=18080

# SmolVLA is a practical starting point for a 4070 Ti, with a compatible checkpoint.
# Other server choices: act, diffusion, tdmpc, vqbet, pi0, pi05, groot.
POLICY_TYPE=smolvla
# REQUIRED: Hub repo ID or absolute checkpoint path ON THE GPU SERVER.
# A generic base VLA is not automatically a zero-shot SO-101 controller.
MODEL=''
POLICY_DEVICE=cuda
TASK=''

# Use the port and calibration ID from your working SO-101 setup.
ROBOT_PORT=''
ROBOT_ID=''
# REQUIRED: camera names and image sizes must match the checkpoint/training setup.
# Example ONLY: '{front: {type: opencv, index_or_path: 0, width: 640, height: 480, fps: 30}}'
CAMERAS=''

# Match the checkpoint/dataset control rate. Choose <= the model's action chunk size.
FPS=30
ACTIONS_PER_CHUNK=''
CHUNK_SIZE_THRESHOLD=0.5
